--Explore the length of #ID (should be 16 characters)
SELECT lENGTH(ride_id) AS ride_id_length
FROM `steam-nuance-493517-n7.cyclistic_ride_share.combined_2025_data`
GROUP BY LENGTH(ride_id);

--Explore ride duration
SELECT ride_id, started_at, ended_at
FROM `steam-nuance-493517-n7.cyclistic_ride_share.combined_2025_data`
WHERE 
TIMESTAMP_DIFF(ended_at, started_at, MINUTE) <= 1 OR
TIMESTAMP_DIFF(ended_at, started_at, MINUTE) >= 1440;

--Explore ride length
SELECT 
started_at,
ended_at,
-- 1. Calculate total seconds first, then format as HH:MM:SS
 FORMAT(
    '%02d:%02d:%02d',
    DIV(TIMESTAMP_DIFF(ended_at, started_at, SECOND), 3600), -- Total cumulative hours
    DIV(MOD(TIMESTAMP_DIFF(ended_at, started_at, SECOND), 3600), 60), -- Remaining minutes
    MOD(TIMESTAMP_DIFF(ended_at, started_at, SECOND), 60) -- Remaining seconds
  ) AS ride_length
FROM `steam-nuance-493517-n7.cyclistic_ride_share.combined_2025_data`;

--Create Day of the week column
SELECT 
started_at,
ended_at,
-- 1. Create the day_of_week column (1 = Sunday, 7 = Saturday)
EXTRACT(DAYOFWEEK FROM started_at) AS day_of_week,

-- 2. Keep the raw ride length in seconds (for calculating mean/max later)
TIMESTAMP_DIFF(ended_at, started_at, SECOND) AS ride_length_seconds
FROM `steam-nuance-493517-n7.cyclistic_ride_share.combined_2025_data`;
